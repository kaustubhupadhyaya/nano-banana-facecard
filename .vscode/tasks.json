{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "recipeRef",
      "type": "promptString",
      "description": "Recipe: <goal key>[@vN], e.g. pin_783485666539777054@v1 (facecard.py recipe show <key> lists the versions)"
    },
    {
      "id": "samples",
      "type": "pickString",
      "description": "Pictures this run",
      "options": ["1", "2", "4"],
      "default": "2"
    }
  ],
  "tasks": [
    {
      "label": "Facecard: dry-run a recipe (free)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["facecard.py", "run", "${input:recipeRef}", "--dry-run"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Facecard: run a recipe",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["facecard.py", "run", "${input:recipeRef}", "--samples", "${input:samples}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Facecard: open goals",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["tools/goal_status.py", "--open", "--next"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Facecard: check session",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["facecard.py", "check"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Facecard: re-enter cookies",
      "type": "shell",
      "command": "python",
      "args": [
        "vault.py", "gui",
        "--request", "gemini-cookies-psid:account,gemini-cookies:account",
        "--hint", "gemini-cookies-psid=Password = value of the __Secure-1PSID cookie (starts with g.a000). Leave Notes as is.",
        "--hint", "gemini-cookies=Password = value of the __Secure-1PSIDTS cookie (starts with sidts-). Leave Notes as is."
      ],
      "options": { "cwd": "${env:USERPROFILE}\\.agents\\skills\\secure-vault" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
