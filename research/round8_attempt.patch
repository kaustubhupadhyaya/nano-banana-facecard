+def raw_head_crop(raw_path: Path, out_path: Path, side: int = 768) -> Path | None:
+    """Head-and-shoulders crop of the largest face in a returned image, made like the identity references. The rescue sends THIS, not the whole
+    return, so the model can copy the face but not the framing or the pose of that attempt (night out, 2026-09-21: a whole-return reference made
+    the next attempt copy its upright pose). None when no face is found."""
+    img = cv2.imread(str(raw_path))
+    if img is None:
+        return None
+    info = analyze_face(img)
+    if not info["detected"]:
+        return None
+    x, y, w, h = info["box"]
+    fs = max(w, h)
+    rect = composite.rect_crop(img.shape, x + w / 2, y + h / 2 + fs * 0.1, fs * 3.0, fs * 3.0)
+    crop = composite.take(img, rect)
+    k = side / max(crop.shape[:2])
+    crop = cv2.resize(crop, None, fx=k, fy=k, interpolation=cv2.INTER_AREA if k < 1 else cv2.INTER_CUBIC)
+    cv2.imwrite(str(out_path), crop, [cv2.IMWRITE_JPEG_QUALITY, 95])
+    return out_path
+
